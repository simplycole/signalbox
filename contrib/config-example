# This is an example configuration file for Signalbox. You may remove the # from
# lines you need and copy this file to ~/.config/signalbox/config
# See manpage for a description of the config keys
# TUI-only real PCM spectrum analyzer (spectrum or off)
#visualizer = spectrum
# Cached art in Now Playing: auto, pixel, or off
#album_art = auto
# Inline synced lyrics: three-line, line, or off
#lyrics_display = three-line
#
# User
#user = your@user.name
#password = password
# or
#password_command = gpg --decrypt ~/password

# Proxy (for those who are not living in the USA)
#control_proxy = http://127.0.0.1:9090/
#bind_to = if!tun0

# Keybindings
#act_help = ?
#act_songlove = +
#act_songban = -
#act_stationaddmusic = a
#act_stationcreate = c
#act_stationdelete = d
#act_songexplain = e
#act_stationaddbygenre = g
#act_history = h
#act_songinfo = i
#act_addshared = j
#act_bookmark = b
#act_managestation = =
#act_songnext = n
#act_songpause = S
#act_songpausetoggle = p
#act_songpausetoggle2 =  
#act_songplay = P
#act_quit = q
#act_stationrename = r
#act_stationchange = s
#act_stationcreatefromsong = v
#act_songtired = t
#act_upcoming = u
#act_stationselectquickmix = x
#act_voldown = (
#act_volup = )
#act_volreset = ^
#act_settings = !

# Misc
#audio_quality = high
#autostart_station = 123456
#buffer_seconds = 5
#event_command = /home/user/.config/signalbox/eventcmd
#fifo = /tmp/signalbox
#history = 5
#max_retry = 5
#sort = name_az
#timeout = 30
#volume = 0
# Optional CA bundle override. On Windows, cert.pem beside signalbox.exe is
# used automatically when this is unset.
#ca_bundle = /etc/ssl/certs/ca-certificates.crt
#gain_mul = 1.0
#sample_rate = 0
#audio_pipe = /tmp/mypipe

# Format strings
#format_nowplaying_song = [32m%t[0m by [34m%a[0m on %l[31m%r[0m%@%s
#format_nowplaying_song = [32m%t[0m by [34m%a[0m on %l%r%@%s
#ban_icon =  [32m</3[0m
#love_icon =  [31m<3[0m
#tired_icon =  [33mzZ[0m
#format_nowplaying_station = Station [35m%n[0m
#format_list_song = %i) %a - %t%r (%d)%@%s
#format_time = %e/%t

